{
  "name": "sign-trainer",
  "version": "1.3.9",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "deploy:dev": "wrangler deploy --env dev",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:prod": "wrangler deploy",
    "check": "node scripts/check-js.mjs && node scripts/route-parity-check.mjs && node scripts/architecture-check.mjs && npm run test:unit",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --env dev",
    "db:migrate:dev": "wrangler d1 migrations apply DB --remote --env dev",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote",
    "db:list:local": "wrangler d1 migrations list DB --local --env dev",
    "db:list:dev": "wrangler d1 migrations list DB --remote --env dev",
    "db:list:staging": "wrangler d1 migrations list DB --remote --env staging",
    "db:list:prod": "wrangler d1 migrations list DB --remote",
    "security:check": "npm audit --audit-level=high",
    "predeploy:dev": "node scripts/security-preflight.mjs",
    "predeploy:staging": "node scripts/security-preflight.mjs",
    "predeploy:prod": "node scripts/security-preflight.mjs && node scripts/operations-preflight.mjs",
    "security:preflight": "node scripts/security-preflight.mjs",
    "test": "node --test --test-reporter=spec tests/unit/*.test.js",
    "test:unit": "node --test --test-reporter=spec tests/unit/*.test.js",
    "test:watch": "node --test --watch tests/unit/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-reporter=spec tests/unit/*.test.js",
    "test:architecture": "node scripts/architecture-check.mjs",
    "ops:preflight": "node scripts/operations-preflight.mjs",
    "security:generate-secrets": "node scripts/generate-security-secrets.mjs"
  },
  "devDependencies": {
    "wrangler": "4.136.3"
  },
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10 <12"
  },
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "hono": "4.13.8"
  }
}
