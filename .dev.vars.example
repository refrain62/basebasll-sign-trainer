# SIGN TRAINER local development secrets
# Copy this file to .dev.vars.dev and replace every REPLACE_ME value.
# Never commit .dev.vars.dev.

SESSION_SECRET=REPLACE_ME_WITH_32_PLUS_RANDOM_CHARACTERS
SYSTEM_ADMIN_SECRET=REPLACE_ME_WITH_12_PLUS_CHARS_CONTAINING_LETTERS_AND_NUMBERS
PASSWORD_PEPPER=REPLACE_ME_WITH_32_PLUS_RANDOM_CHARACTERS
DATA_ENCRYPTION_KEY=REPLACE_ME_WITH_32_PLUS_RANDOM_CHARACTERS
DATA_LOOKUP_KEY=REPLACE_ME_WITH_32_PLUS_RANDOM_CHARACTERS

GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_ME_WITH_GOOGLE_OAUTH_CLIENT_SECRET
LINE_CHANNEL_ID=REPLACE_ME_WITH_LINE_LOGIN_CHANNEL_ID
LINE_CHANNEL_SECRET=REPLACE_ME_WITH_LINE_LOGIN_CHANNEL_SECRET

# ACCOUNT_TEAM_CREATE_LIMIT / LINE_REQUEST_EMAIL / CF_ACCESS_* / PUBLIC_* are defined in wrangler.jsonc vars.
# Localhost skips Cloudflare Access verification.
