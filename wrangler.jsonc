{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "basebasll-sign-trainer",
  "main": "./src/index.ts",
  "compatibility_date": "2026-09-22",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none",
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sign-trainer-production",
      "database_id": "bdd534e9-1c42-4db7-adbe-c62e35e123b5",
      "migrations_dir": "./migrations"
    }
  ],
  "secrets": {
    "required": [
      "SESSION_SECRET",
      "SYSTEM_ADMIN_SECRET",
      "PASSWORD_PEPPER",
      "DATA_ENCRYPTION_KEY",
      "DATA_LOOKUP_KEY",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "LINE_CHANNEL_ID",
      "LINE_CHANNEL_SECRET"
    ]
  },
  "vars": {
    "SESSION_DAYS": "30",
    "ADMIN_SESSION_HOURS": "12",
    "ENVIRONMENT": "production",
    "REQUIRE_CF_ACCESS_FOR_SYSTEM_ADMIN": "true",
    "CF_ACCESS_TEAM_DOMAIN": "",
    "CF_ACCESS_POLICY_AUD": "",
    "SYSTEM_ADMIN_ALLOWED_EMAILS": "",
    "ACCOUNT_SESSION_DAYS": "30",
    "LINE_REQUEST_EMAIL": "false",
    "PUBLIC_OPERATOR_NAME": "SIGN TRAINER 運営者",
    "PUBLIC_SUPPORT_URL": "",
    "ACCOUNT_TEAM_CREATE_LIMIT": "3",
    "REQUIRE_CF_ACCESS_FOR_ENVIRONMENT": "false",
    "ENVIRONMENT_ACCESS_ALLOWED_EMAILS": ""
  },
  "env": {
    "dev": {
      "workers_dev": true,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sign-trainer-dev",
          "database_id": "3b47491c-8e2a-412a-b2a7-1a06922b3604",
          "migrations_dir": "./migrations"
        }
      ],
      "secrets": {
        "required": [
          "SESSION_SECRET",
          "SYSTEM_ADMIN_SECRET",
          "PASSWORD_PEPPER",
          "DATA_ENCRYPTION_KEY",
          "DATA_LOOKUP_KEY",
          "GOOGLE_CLIENT_ID",
          "GOOGLE_CLIENT_SECRET",
          "LINE_CHANNEL_ID",
          "LINE_CHANNEL_SECRET"
        ]
      },
      "vars": {
        "SESSION_DAYS": "30",
        "ADMIN_SESSION_HOURS": "12",
        "ENVIRONMENT": "dev",
        "REQUIRE_CF_ACCESS_FOR_SYSTEM_ADMIN": "true",
        "SYSTEM_ADMIN_ALLOWED_EMAILS": "",
        "ACCOUNT_SESSION_DAYS": "30",
        "LINE_REQUEST_EMAIL": "false",
        "CF_ACCESS_TEAM_DOMAIN": "",
        "CF_ACCESS_POLICY_AUD": "",
        "PUBLIC_OPERATOR_NAME": "SIGN TRAINER 運営者",
        "PUBLIC_SUPPORT_URL": "https://forms.gle/n9qume9WF3KNGkPP6",
        "ACCOUNT_TEAM_CREATE_LIMIT": "3",
        "REQUIRE_CF_ACCESS_FOR_ENVIRONMENT": "true",
        "ENVIRONMENT_ACCESS_ALLOWED_EMAILS": ""
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      }
    },
    "staging": {
      "workers_dev": true,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sign-trainer-staging",
          "database_id": "2ca39d6b-e06f-44b4-862b-b0c2932d9310",
          "migrations_dir": "./migrations"
        }
      ],
      "secrets": {
        "required": [
          "SESSION_SECRET",
          "SYSTEM_ADMIN_SECRET",
          "PASSWORD_PEPPER",
          "DATA_ENCRYPTION_KEY",
          "DATA_LOOKUP_KEY",
          "GOOGLE_CLIENT_ID",
          "GOOGLE_CLIENT_SECRET",
          "LINE_CHANNEL_ID",
          "LINE_CHANNEL_SECRET"
        ]
      },
      "vars": {
        "SESSION_DAYS": "30",
        "ADMIN_SESSION_HOURS": "12",
        "ENVIRONMENT": "staging",
        "REQUIRE_CF_ACCESS_FOR_SYSTEM_ADMIN": "true",
        "SYSTEM_ADMIN_ALLOWED_EMAILS": "",
        "ACCOUNT_SESSION_DAYS": "30",
        "LINE_REQUEST_EMAIL": "false",
        "CF_ACCESS_TEAM_DOMAIN": "https://refrain62.cloudflareaccess.com",
        "CF_ACCESS_POLICY_AUD": "a54593b99ae28951c7c1838ff099a8548c759944bcb5a14946d076322c8311a2",
        "PUBLIC_OPERATOR_NAME": "SIGN TRAINER 運営者",
        "PUBLIC_SUPPORT_URL": "https://forms.gle/n9qume9WF3KNGkPP6",
        "ACCOUNT_TEAM_CREATE_LIMIT": "3",
        "REQUIRE_CF_ACCESS_FOR_ENVIRONMENT": "true",
        "ENVIRONMENT_ACCESS_ALLOWED_EMAILS": ""
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      }
    }
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}
